pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        TZ = 'Asia/Shanghai'
        DOCKER_BUILDKIT = '1'

        IMAGE_NAME = 'zhaoyao/academy-front'
        APP_CONTAINER = 'academy-front'
        APP_PORT = '3000'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare image tag') {
            steps {
                script {
                    def commit = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.RELEASE_TAG = "${env.BUILD_NUMBER}-${commit}"
                    env.APP_IMAGE = "${env.IMAGE_NAME}:${env.RELEASE_TAG}"
                    env.MIGRATOR_IMAGE = "${env.IMAGE_NAME}-migrator:${env.RELEASE_TAG}"

                    echo "Application image: ${env.APP_IMAGE}"
                }
            }
        }

        stage('Check base containers') {
            steps {
                sh '''
                    set -eu

                    docker network inspect "$MYSQL_NETWORK" >/dev/null
                    docker network inspect "$MINIO_NETWORK" >/dev/null

                    echo "Docker networks are available."
                '''
            }
        }

        stage('Build images') {
            steps {
                sh '''
                    set -eu

                    docker build \
                        --pull \
                        -f academy-front/Dockerfile \
                        --target migrator \
                        -t "$MIGRATOR_IMAGE" \
                        academy-front

                    docker build \
                        --pull \
                        -f academy-front/Dockerfile \
                        -t "$APP_IMAGE" \
                        academy-front
                '''
            }
        }

        stage('Run database migration') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'zhaoyao-academy-front-env',
                        variable: 'PROD_ENV_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        test -r "$PROD_ENV_FILE"

                        docker run \
                            --rm \
                            --name "academy-migrate-${BUILD_NUMBER}" \
                            --network "$MYSQL_NETWORK" \
                            --env-file "$PROD_ENV_FILE" \
                            --env TZ="$TZ" \
                            "$MIGRATOR_IMAGE"
                    '''
                }
            }
        }

        stage('Replace academy-front container') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'zhaoyao-academy-front-env',
                        variable: 'PROD_ENV_FILE'
                    )
                ]) {
                    sh '''
                        set -eu

                        if docker container inspect "$APP_CONTAINER" >/dev/null 2>&1; then
                            docker rm -f "$APP_CONTAINER"
                        fi

                        docker create \
                            --name "$APP_CONTAINER" \
                            --restart unless-stopped \
                            --network "$MYSQL_NETWORK" \
                            --publish "$APP_PORT:3000" \
                            --env-file "$PROD_ENV_FILE" \
                            --env TZ="$TZ" \
                            "$APP_IMAGE"

                        docker network connect "$MINIO_NETWORK" "$APP_CONTAINER"

                        docker start "$APP_CONTAINER"
                    '''
                }
            }
        }

        stage('Verify deployment') {
            steps {
                sh '''
                    set -eu

                    running="$(
                        docker inspect \
                            -f '{{.State.Running}}' \
                            "$APP_CONTAINER"
                    )"

                    test "$running" = "true"

                    docker exec "$APP_CONTAINER" \
                        node -e '
                            fetch("http://127.0.0.1:3000/")
                              .then(response => {
                                  if (response.status >= 500) {
                                      process.exit(1);
                                  }
                              })
                              .catch(() => process.exit(1));
                        '

                    docker ps \
                        --filter "name=$APP_CONTAINER" \
                        --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'
                '''
            }
        }
    }

    post {
        failure {
            sh '''
                docker logs --tail=200 "$APP_CONTAINER" 2>/dev/null || true
            '''
        }

        always {
            sh '''
                docker image rm "$MIGRATOR_IMAGE" 2>/dev/null || true
            '''
        }
    }
}
