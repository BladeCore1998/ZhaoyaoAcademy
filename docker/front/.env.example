# 复制为同目录 .env 后使用；不要提交真实密钥。
FRONT_PORT=3000

# 生产环境请替换为随机密钥；域名或 FRONT_PORT 改动后同步修改 URL。
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# 容器间使用共享网络内的服务名，不使用宿主机 localhost。
DATABASE_URL=mysql://academy:academy@mysql:3306/academy
REDIS_URL=redis://redis:6379

# RustFS 凭据须与 docker/common/.env 保持一致。
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_ACCESS_KEY=academy
RUSTFS_SECRET_KEY=academy-secret
RUSTFS_BUCKET=zhaoyao-academy
